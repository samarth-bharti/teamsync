# Supabase — used SERVER-SIDE ONLY. Never expose the service-role key to the browser.
# Find these in your Supabase project: Project Settings -> API
# NOTE: this is a COMMITTED template. Put REAL values in .env.local (gitignored) — NEVER here.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Public (browser-safe) — used for FREELANCER LOGIN via @supabase/ssr.
# NEXT_PUBLIC_SUPABASE_URL is the same Project URL as SUPABASE_URL above.
# NEXT_PUBLIC_SUPABASE_ANON_KEY is the "anon"/"public" key (NOT service_role).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
